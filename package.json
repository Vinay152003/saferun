{
  "name": "saferun-core",
  "version": "0.0.1",
  "description": "Run untrusted / AI-generated code in a disposable Solari sandbox and see what it did — before it touches your machine.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx scripts/scan.ts",
    "dev": "npm run dev --prefix web"
  },
  "keywords": [
    "solari",
    "sandbox",
    "security",
    "untrusted-code",
    "malware-analysis"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@solarisdk/sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
