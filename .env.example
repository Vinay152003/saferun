# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
# (This template IS committed — keep it placeholders only.)
#
# NOTE: the deployed web app is bring-your-own-key and needs NO server keys.
# These are only for running the CLI / library locally (`npm run scan`).

# Solari API key — sign up at getsolari.com. Format: slr_live_...
SOLARI_API_KEY=slr_live_your_key_here

# Anthropic API key — powers the plain-English verdict. Format: sk-ant-...
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Which Claude model writes the verdict. claude-haiku-4-5 is cheap and plenty;
# omit to use the default (claude-opus-5).
SAFERUN_MODEL=claude-haiku-4-5
